# =====================================================================
#                 GHOSTMIND Platform Environment Configuration
# =====================================================================

# PostgreSQL Central Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ghostmind

# Google OAuth 2.0 Credentials (Required for Google-only authentication)
# Create in Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Session Security & Encryption
SESSION_SECRET=ghostmind-super-secure-session-secret-change-in-prod-xyz789
TOKEN_ENCRYPTION_KEY=

# Local Ollama AI Engine
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Local Whisper Speech Recognition (tiny, base, small, medium)
WHISPER_MODEL_SIZE=base

# File Storage
APP_DATA_DIR=
MAX_UPLOAD_SIZE_MB=25
